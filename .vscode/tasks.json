{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create C++ build directory",
            "type": "process",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/.build/${relativeFileDirname}"
            ],
            "problemMatcher": []
        },
        {
            "label": "C/C++: g++ build active file",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/.build/${relativeFileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Create C++ build directory",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
