{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: g++ build and run active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build/${relativeFileDirname}/${fileBasenameNoExtension}",
            "args": [
                "${input:windowTitle}"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: g++ build active file"
        }
    ],
    "inputs": [
        {
            "id": "windowTitle",
            "type": "promptString",
            "description": "Enter part of the window title to activate"
        }
    ]
}
